[Unit]
Description=ZEC Strategy Live Execution Engine
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/quant-shadow/zec-4h-small-live.env

[Service]
Type=simple
User=codex
Group=codex
WorkingDirectory=/opt/quant-shadow/qq
# Master exchange-write permission remains independent from the web-managed
# strategy_enabled flag. Existing EnvironmentFile values may arm the master.
Environment=ZEC_4H_LIVE_ENABLED=false
Environment=ZEC_4H_PREFLIGHT_ENABLED=false
Environment=ZEC_4H_LIVE_ACTIVATION=disabled
EnvironmentFile=-/etc/quant-shadow/zec-4h-small-live.env
ExecStart=/usr/bin/python3 /opt/quant-shadow/qq/scripts/run_zec_4h_small_live.py
Restart=on-failure
RestartSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/quant-shadow/zec-4h-small-live
ReadOnlyPaths=/var/lib/quant-shadow/zec-control
UMask=0077

[Install]
WantedBy=multi-user.target
