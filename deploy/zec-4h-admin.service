[Unit]
Description=ZECUSDT 4H Read-Only Admin Dashboard
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/quant-shadow/zec-4h-admin.env

[Service]
Type=simple
User=codex
Group=codex
WorkingDirectory=/opt/quant-shadow/qq
Environment=ZEC_4H_ADMIN_BIND=127.0.0.1
# 8765 is reserved by the existing Heima Strategy Lab API on production.
Environment=ZEC_4H_ADMIN_PORT=8766
# Read the same API credentials/flags as the executor, but the admin adapter is
# always constructed with live_enabled=False and exposes no write endpoints.
EnvironmentFile=-/etc/quant-shadow/zec-4h-small-live.env
EnvironmentFile=/etc/quant-shadow/zec-4h-admin.env
ExecStart=/usr/bin/python3 /opt/quant-shadow/qq/scripts/run_zec_4h_admin.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
# The admin may mutate only governed runtime config/audit documents. It has no
# write access to strategy state, ledgers, repository files, or credentials.
StateDirectory=quant-shadow/zec-control
StateDirectoryMode=0700
ReadWritePaths=/var/lib/quant-shadow/zec-control
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
